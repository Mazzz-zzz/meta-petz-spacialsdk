fun createWallsForFloorPlaneWorld(
    floorEntity: Entity,
    worldRoot: Entity,
    wallHeight: Float = 2.5f,
    wallThickness: Float = 0.05f,
    minEdgeLength: Float = 0.05f
) {
    val plane = floorEntity.getComponent(MRUKPlane::class.java)
    val planeTransform = floorEntity.getComponent(Transform::class.java)
    val boundary = plane.boundary

    if (boundary.size < 2) {
        Log.w(TAG, "Plane boundary has too few points: ${boundary.size}")
        return
    }

    val world = floorEntity.world

    // Convert boundary to WORLD 3D points first
    val worldBoundary = boundary.map { p2 ->
        val local3 = Vector3(p2.x, 0f, p2.y)
        planeTransform.localToWorld(local3)   // implement this for your Transform
    }

    worldBoundary.indices.forEach { i ->
        val a = worldBoundary[i]
        val b = worldBoundary[(i + 1) % worldBoundary.size]

        val dx = b.x - a.x
        val dz = b.z - a.z
        val length = hypot(dx.toDouble(), dz.toDouble()).toFloat()
        if (length < minEdgeLength) return@forEach

        val mx = (a.x + b.x) * 0.5f
        val mz = (a.z + b.z) * 0.5f
        val center = Vector3(mx, wallHeight * 0.5f, mz)

        val yaw = atan2(dz, dx)

        val wall = world.createEntity("Wall_$i")
        wall.parent = worldRoot   // SAME root as bone; NOT the plane entity

        val t = wall.addComponent(Transform::class.java)
        t.position = center
        t.rotation = quaternionFromYaw(yaw)
        t.scale = Vector3(length, wallHeight, wallThickness)

        val meshComp = wall.addComponent(MeshComponent::class.java)
        meshComp.mesh = unitCubeMesh()

        val phys = wall.addComponent(PhysicsBoxComponent::class.java)
        phys.size = Vector3(length, wallHeight, wallThickness)
        phys.isKinematic = true
    }
}



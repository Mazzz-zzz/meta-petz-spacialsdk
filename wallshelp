fun createWallsForFloorPlaneLocal(
    floorEntity: Entity,
    wallHeight: Float = 2.5f,
    wallThickness: Float = 0.05f,
    minEdgeLength: Float = 0.05f
) {
    val plane = floorEntity.getComponent(MRUKPlane::class.java)
    val boundary = plane.boundary           // List<Vector2>, PLANE LOCAL

    if (boundary.size < 2) {
        Log.w(TAG, "Plane boundary has too few points: ${boundary.size}")
        return
    }

    val world = floorEntity.world

    boundary.indices.forEach { i ->
        val a = boundary[i]
        val b = boundary[(i + 1) % boundary.size]

        val dx = b.x - a.x
        val dz = b.y - a.y
        val length = hypot(dx.toDouble(), dz.toDouble()).toFloat()
        if (length < minEdgeLength) return@forEach

        // Midpoint in PLANE-LOCAL 3D
        val mx = (a.x + b.x) * 0.5f
        val mz = (a.y + b.y) * 0.5f
        val localCenter = Vector3(mx, wallHeight * 0.5f, mz)

        // Yaw around local Y (up) axis in plane space
        val yaw = atan2(dz, dx)  // radians

        val wall = world.createEntity("Wall_$i")
        wall.parent = floorEntity   // <- key: inherit plane transform

        val t = wall.addComponent(Transform::class.java)
        t.position = localCenter
        t.rotation = quaternionFromYaw(yaw)
        t.scale = Vector3(length, wallHeight, wallThickness)

        // Visual
        val meshComp = wall.addComponent(MeshComponent::class.java)
        meshComp.mesh = unitCubeMesh()

        // Physics – adjust if your API expects half-extents instead
        val phys = wall.addComponent(PhysicsBoxComponent::class.java)
        phys.size = Vector3(length, wallHeight, wallThickness)
        phys.isKinematic = true
    }
}

fun quaternionFromYaw(yaw: Float): Quaternion {
    val half = yaw * 0.5f
    val s = sin(half)
    val c = cos(half)
    // yaw around Y
    return Quaternion(0f, s, 0f, c)
}


Why this should track correctly:

Boundary points are interpreted in the same local space MRUK uses.

By parenting walls under floorEntity, they automatically move into world space via that transform.

If your bones are also in world / room space, everything stays fixed in the room as you walk.

